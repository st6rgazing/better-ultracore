#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const { spawn } = require('node:child_process');
const { classify } = require('../lib/classify');
const { context, affected } = require('../lib/context');

// DISPATCH HOOK: subcommands implemented by other modules, each exporting run(argv).
// Guarded by an existence check so buc still works when a module is absent.
const EXTERNAL = {
  prefs: path.join(__dirname, '..', 'lib', 'prefs', 'cli.js'),
  preflight: path.join(__dirname, '..', 'lib', 'preflight', 'cli.js'),
};

const KILL_GRACE_MS = 5000;
const CLAUDE = process.env.BUC_CLAUDE_BIN || 'claude';

const BOOLEAN = new Set(['offline']);

function parseFlags(argv) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const key = argv[i].replace(/^--/, '');
    flags[key] = BOOLEAN.has(key) ? true : argv[++i];
  }
  return flags;
}

const commands = {
  classify(argv) {
    const f = parseFlags(argv);
    if (!f.request) throw new Error('classify needs --request "<text>"');
    console.log(JSON.stringify(classify(f.request)));
  },
  context(argv) {
    const f = parseFlags(argv);
    if (!f.request) throw new Error('context needs --request "<text>"');
    console.log(JSON.stringify(context(f.request, { ref: f.ref, offline: f.offline })));
  },
  // buc affected --steps checkpoint.json --files a,b  (checkpoint: result JSON or its completed_steps array)
  affected(argv) {
    const f = parseFlags(argv);
    if (!f.steps || !f.files) throw new Error('affected needs --steps <json file> and --files a,b');
    const data = JSON.parse(fs.readFileSync(f.steps, 'utf8'));
    const steps = Array.isArray(data) ? data : data.completed_steps;
    const areas = f.files.split(',').filter(Boolean);
    const rerun = affected(steps, areas);
    console.log(JSON.stringify({ since: f.since || null, rerun, keep: steps.map((s) => s.id).filter((id) => !rerun.includes(id)) }));
  },
  // Wall clock enforced here: SIGTERM at the timeout, SIGKILL after a grace period.
  'run-headless'(argv) {
    const f = parseFlags(argv);
    if (!f.prompt) throw new Error('run-headless needs --prompt "<text>"');
    const args = ['-p', f.prompt, '--output-format', 'json', '--plugin-dir', f['plugin-dir'] || '.',
      '--model', f.model || 'sonnet', '--max-budget-usd', f['max-budget-usd'] || '1'];
    const started = Date.now();
    const child = spawn(CLAUDE, args, { cwd: f.cwd || process.cwd(), stdio: ['ignore', 'pipe', 'inherit'], detached: true });
    let out = '';
    let timedOut = false;
    child.stdout.on('data', (d) => { out += d; });
    const term = setTimeout(() => {
      timedOut = true;
      process.kill(-child.pid, 'SIGTERM');
      setTimeout(() => { try { process.kill(-child.pid, 'SIGKILL'); } catch { /* already gone */ } }, KILL_GRACE_MS).unref();
    }, parseFloat(f['timeout-min'] || '15') * 60000);
    child.on('close', (code, signal) => {
      clearTimeout(term);
      let r = {};
      try { r = JSON.parse(out); } catch { r = { result: out.trim() || null }; }
      console.log(JSON.stringify({
        exit: code ?? signal,
        timed_out: timedOut,
        elapsed_ms: Date.now() - started,
        total_cost_usd: r.total_cost_usd ?? null,
        usage: r.usage ?? null,
        num_turns: r.num_turns ?? null,
        subagent_stats: r.subagent_stats ?? r.modelUsage ?? null,
        result: r.result ?? null,
      }));
    });
  },
};

async function main(argv) {
  const [sub, ...rest] = argv;
  if (commands[sub]) return commands[sub](rest);
  if (EXTERNAL[sub] && fs.existsSync(EXTERNAL[sub])) return require(EXTERNAL[sub]).run(rest);
  console.error('usage: buc classify|context|affected|run-headless|prefs|preflight [options]');
  process.exitCode = 2;
}

main(process.argv.slice(2)).catch((e) => {
  console.error(e.message);
  process.exitCode = 1;
});
