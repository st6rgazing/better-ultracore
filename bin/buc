#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { spawn } = require('node:child_process');
const { classify } = require('../lib/classify');
const { context, affected } = require('../lib/context');
const { readRequest } = require('../lib/request');
const { DEFAULT_LIMITS } = require('../lib/engine');

// DISPATCH HOOK: subcommands implemented by other modules, each exporting run(argv).
// Guarded by an existence check so buc still works when a module is absent.
const EXTERNAL = {
  preflight: path.join(__dirname, '..', 'lib', 'preflight', 'cli.js'),
  rules: path.join(__dirname, '..', 'lib', 'rules', 'cli.js'),
};

const KILL_GRACE_MS = 5000;
const CLAUDE = process.env.BUC_CLAUDE_BIN || 'claude';

const BOOLEAN = new Set(['no-plugin', 'offline', 'dry-run']);

function parseFlags(argv) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const key = argv[i].replace(/^--/, '');
    flags[key] = BOOLEAN.has(key) ? true : argv[++i];
  }
  return flags;
}

const commands = {
  classify(argv) {
    const request = readRequest(parseFlags(argv));
    if (!request) throw new Error('classify needs --request "<text>" or --request-file <path|->');
    console.log(JSON.stringify(classify(request)));
  },
  context(argv) {
    const f = parseFlags(argv);
    const request = readRequest(f);
    if (!request) throw new Error('context needs --request "<text>" or --request-file <path|->');
    console.log(JSON.stringify(context(request, { ref: f.ref, offline: f.offline })));
  },
  // buc affected --steps checkpoint.json --files a,b  (checkpoint: result JSON or its completed_steps array)
  affected(argv) {
    const f = parseFlags(argv);
    if (!f.steps || !f.files) throw new Error('affected needs --steps <json file> and --files a,b');
    const data = JSON.parse(fs.readFileSync(f.steps, 'utf8'));
    const steps = Array.isArray(data) ? data : data.completed_steps;
    const areas = f.files.split(',').filter(Boolean);
    const rerun = affected(steps, areas);
    console.log(JSON.stringify({ since: f.since || null, rerun, keep: steps.map((s) => s.id).filter((id) => !rerun.includes(id)) }));
  },
  // buc learn [--projects-root dir] [--dry-run]: collect corrective user turns for /buc learn clustering.
  // Each candidate is {session_id, text, repo, h, ts}. Without --dry-run they are queued in the inbox, which is where
  // `buc rules import` looks up a rule's `sources: [h]`.
  learn(argv) {
    const f = parseFlags(argv);
    const root = f['projects-root'] || path.join(os.homedir(), '.claude', 'projects');
    const found = require('../lib/rules/mine').mine(root);
    if (f['dry-run']) return void console.log(JSON.stringify(found));
    const store = require('../lib/rules/store');
    const known = new Set(store.readInbox().map((i) => i.text.toLowerCase()));
    const fresh = found.filter((c) => !known.has(c.text.toLowerCase()));
    store.appendInbox(fresh.map((c) => ({ ts: new Date(store.now()).toISOString(), ...c })));
    console.log(JSON.stringify({ candidates: found.length, appended: fresh.length }));
  },
  // buc handsoff [on|off|auto] [--cwd dir]: set or show hands-off mode for the repo that contains cwd.
  handsoff([value, ...rest]) {
    const f = parseFlags(value && value.startsWith('--') ? [value, ...rest] : rest);
    const setting = value && !value.startsWith('--') ? value : null;
    const { execFileSync } = require('node:child_process');
    const handsoff = require('../lib/handsoff');
    let root;
    try {
      root = execFileSync('git', ['-C', f.cwd || process.cwd(), 'rev-parse', '--show-toplevel'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
    } catch {
      throw new Error('handsoff works per git repo; run it inside one');
    }
    const repo = require('../lib/context').repoKey(root);
    if (setting && !handsoff.set(repo, setting)) throw new Error('could not write repos.json');
    console.log(JSON.stringify({ repo, setting: require('../lib/rules/store').repoState(repo).handsOff || 'auto', ...handsoff.mode(repo, { root }) }));
  },
  // buc check --session <id>: run the deterministic checks of the last turn's matched rules; exit 1 on failure.
  check(argv) {
    const f = parseFlags(argv);
    if (!f.session) throw new Error('check needs --session <id>');
    const results = require('../lib/rules/check').checkSession(f.session);
    console.log(JSON.stringify(results));
    return results.some((r) => !r.pass) ? 1 : 0;
  },
  // Wall clock enforced here: SIGTERM at the timeout, SIGKILL after a grace period.
  'run-headless'(argv) {
    const f = parseFlags(argv);
    const prompt = f.prompt || readRequest(f);
    if (!prompt) throw new Error('run-headless needs --prompt "<text>" or --request-file <path|->');
    const args = ['-p', prompt, '--output-format', 'json', '--plugin-dir', f['plugin-dir'] || path.join(__dirname, '..'),
      '--model', f.model || 'sonnet', '--max-budget-usd', f['max-budget-usd'] || '1',
      '--permission-mode', f['permission-mode'] || 'acceptEdits'];
    if (f['allowed-tools']) args.push('--allowedTools', ...f['allowed-tools'].split(','));
    if (f['no-plugin']) args.splice(args.indexOf('--plugin-dir'), 2);
    const timeoutMin = parseFloat(f['timeout-min'] || DEFAULT_LIMITS.maxElapsedMin);
    const started = Date.now();
    const child = spawn(CLAUDE, args, { cwd: f.cwd || process.cwd(), stdio: ['ignore', 'pipe', 'inherit'], detached: true });
    let out = '';
    let timedOut = false;
    child.stdout.on('data', (d) => { out += d; });
    const term = setTimeout(() => {
      timedOut = true;
      process.kill(-child.pid, 'SIGTERM');
      setTimeout(() => { try { process.kill(-child.pid, 'SIGKILL'); } catch { /* already gone */ } }, KILL_GRACE_MS).unref();
    }, timeoutMin * 60000);
    child.on('close', (code, signal) => {
      clearTimeout(term);
      let r = {};
      try { r = JSON.parse(out); } catch { r = { result: out.trim() || null }; }
      console.log(JSON.stringify({
        exit: code ?? signal,
        timed_out: timedOut,
        timeout_min: timeoutMin,
        elapsed_ms: Date.now() - started,
        total_cost_usd: r.total_cost_usd ?? null,
        usage: r.usage ?? null,
        num_turns: r.num_turns ?? null,
        subagent_stats: r.subagent_stats ?? null,
        model_usage: r.modelUsage ?? null,
        result: r.result ?? null,
      }));
    });
  },
};

async function main(argv) {
  const [sub, ...rest] = argv;
  if (commands[sub]) return commands[sub](rest);
  if (EXTERNAL[sub] && fs.existsSync(EXTERNAL[sub])) return require(EXTERNAL[sub]).run(rest);
  console.error('usage: buc classify|context|affected|learn|check|rules|handsoff|run-headless|preflight [options]');
  process.exitCode = 2;
}

main(process.argv.slice(2)).then((code) => {
  if (typeof code === 'number') process.exitCode = code;
}).catch((e) => {
  console.error(e.message);
  process.exitCode = 1;
});
